# ==============================================================================
# ExamGo / MyPath Backend Service - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
#
# IMPORTANT: Never commit the real .env file containing API keys into git.
# ==============================================================================

# Resend API Key (Sign up at https://resend.com to generate your key)
RESEND_API_KEY=re_your_api_key_here

# Sender Email Address
# Default sandbox address for Resend: ExamGo Alerts <onboarding@resend.dev>
# For production: MyPath Team <noreply@wildcodestudios.in> or your verified domain
SENDER_EMAIL=ExamGo Alerts <onboarding@resend.dev>

# Default Recipient Email Address for Exam Notifications
# NOTE: When sending from onboarding@resend.dev, Resend sandbox requires this to match
# your verified Resend account owner email address.
NOTIFICATION_RECIPIENT_EMAIL=aspirant@example.com

# Server Port (used by index.js for local development)
PORT=10000
