rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Only authenticated users can read profiles (no public access)
      allow read: if request.auth != null;
      // Allow creating a new profile document for your own UID
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow updating if it's your own UID OR if your verified Google email matches
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      // Allow deletion if it's your UID or your emails match
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        (request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
    }

    // Exams collection: readable by all logged-in users, writable only by admins (backend service account)
    match /exams/{examId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Firebase Admin SDK (backend) can write
    }

    // Notifications log: users can only read their own
    match /notifications/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only backend writes
    }

    // Default catch-all: deny everything not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
